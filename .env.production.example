# ==============================================================================
# GST Ledger - Production Environment Variables Example
# Duplicate as .env.production or set in your Cloud Provider (Render / Fly.io / AWS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NextAuth Authentication & Session Security (REQUIRED)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32 (Must be >= 32 characters)
NEXTAUTH_SECRET=generate_strong_production_secret_key_minimum_32_chars_long

# Canonical public URL of your application (no trailing slash)
NEXTAUTH_URL=https://ledgerxai.onrender.com

# ------------------------------------------------------------------------------
# 2. SQLite Database & Storage (REQUIRED)
# ------------------------------------------------------------------------------
# Persistent SQLite database path with busy timeout and connection limits
DATABASE_URL=file:../data/app.db?connection_limit=1&busy_timeout=30000

# ------------------------------------------------------------------------------
# 3. Transactional Email Dispatch (RECOMMENDED)
# ------------------------------------------------------------------------------
# Provider Option A: Resend API (Fastest & recommended for SaaS)
RESEND_API_KEY=re_your_resend_api_key_here

# Provider Option B: Standard SMTP / Nodemailer (Fallback if Resend is unset)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_SECURE=false

# Verified From Email Address
EMAIL_FROM=GST Ledger <noreply@ledgerxai.onrender.com>

# ------------------------------------------------------------------------------
# 4. AI & OCR Extraction (OPTIONAL)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
