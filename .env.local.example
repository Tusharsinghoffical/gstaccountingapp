# ==============================================================================
# GST Ledger - Environment Variables Example
# Copy this file to .env.local and fill in the appropriate values.
# IMPORTANT:
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - SUPABASE_SERVICE_ROLE_KEY and GROQ_API_KEY MUST NEVER have NEXT_PUBLIC_ prefix.
# - Do not use any AWS SDK or AWS-dependent services in this project.
# ==============================================================================

# Supabase Public Configuration (Browser and Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Configuration (Admin / Edge / Server Tasks)
# NEVER EXPOSE TO CLIENT CODE
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq API Configuration (Server / Edge Functions Only)
# NEVER EXPOSE TO CLIENT CODE
GROQ_API_KEY=gsk_your-groq-api-key-here
