# ==============================================================================
# GST Ledger - Local Environment Variables
# Copy this file to .env.local and fill in the appropriate values.
# No Supabase, AWS, or Cloud BaaS required.
# ==============================================================================

# NextAuth.js Configuration
NEXTAUTH_SECRET=gst-ledger-local-secret-key-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# Groq API Configuration (Server-Only, used for OCR and Invoice Category AI)
GROQ_API_KEY=gsk_your-groq-api-key-here

# SQLite Database Location (defaults to file:../data/app.db via prisma/schema.prisma)
DATABASE_URL=file:../data/app.db?connection_limit=1&busy_timeout=30000
